          "locator": "main/block[1]",
          "population_status": "adult_dev_candidate",
          "section": "What is age-related hearing loss?",
          "start": 0,
          "text": "Age-related hearing loss (also called presbycusis, pronounced prez-buh-KYOO-sis) is hearing loss that occurs gradually for many of us as we grow older. It is one of the most common conditions affecting adults as we age. Approximately 15% of American adults (37.5 million) ages 18 and over report some trouble hearing, and about one in three people in the U.S. between the ages of 65 and 74 has hearing loss. Nearly half of those older than 75 have difficulty hearing.",
          "chunk_id": "23016a42e1f434dbe7b202f5",
          "document_id": "nidcd-presbycusis",
          "version_id": "6c17226f-5c23-409e-b71d-2c7e29c607d1",
          "snapshot_id": "afaf8187-9cda-45f3-a80c-457433e2d2a2",
